# --- Required for mdwb server, CLI + ops automation ---
OLMOCR_SERVER=https://ai2endpoints.cirrascale.ai/api
OLMOCR_API_KEY=sk-***
OLMOCR_MODEL=olmOCR-2-7B-1025-FP8
# Legacy CLI aliases (supported as fallbacks by app.settings)
OCR_SERVER=https://ai2endpoints.cirrascale.ai/api
OCR_API_KEY=sk-***
OCR_MODEL=olmOCR-2-7B-1025-FP8
API_BASE_URL=http://localhost:8007
MDWB_API_KEY=
REQUIRE_API_KEY=false
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=60
# Arbitrary capture/webhook traffic is public-network only by default.
# Server-owned grants, e.g.127.0.0.1/32; never accept these from request bodies.
NETWORK_PRIVATE_CIDRS=
# Exact stored owner identities, e.g.owner:research-team,key:12
NETWORK_TRUSTED_OWNERS=
# Grant anonymous local operators only when REQUIRE_API_KEY=false.
NETWORK_TRUST_LOCAL_OPERATOR=false
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_POST_ENDPOINT=
SEMANTIC_POST_MODEL=
SEMANTIC_POST_API_KEY=
QUEUE_MAX_JOBS=10
QUEUE_JOB_TIMEOUT=3600
QUEUE_KEEP_RESULT=3600
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=60
# --- Optional/advanced settings (CLI will fall back to defaults) ---
OCR_LOCAL_URL=http://localhost:8001
OCR_LOCAL_AUTOSTART=true
OCR_LOCAL_STARTUP_TIMEOUT_S=180
OCR_LOCAL_HEALTHCHECK_TIMEOUT_S=5
OCR_LOCAL_MAX_RESTARTS=1
OCR_USE_FP8=true
OCR_MAX_BATCH_TILES=3
OCR_MAX_BATCH_BYTES=25000000
OCR_DAILY_QUOTA_TILES=
CACHE_ROOT=.cache
RUNS_DB_PATH=runs.db
CFT_VERSION=chrome-130.0.6723.69
CFT_LABEL=Stable-1
CFT_EXECUTABLE_PATH=
CFT_ENFORCE_PIN=false
MAX_CONCURRENT_BROWSERS=4
# Optional exact executable; otherwise ~/.cache/mdwb/cft/<build>/chrome-linux64/chrome
CFT_EXECUTABLE=
# Optional Linux fontconfig override; default capture uses isolated system fonts.
PLAYWRIGHT_FONTCONFIG_FILE=
PLAYWRIGHT_CHANNEL=cft
PLAYWRIGHT_TRANSPORT=cdp
VIEWPORT_OVERLAP_PX=120
CAPTURE_LONG_SIDE_PX=1288
TILE_OVERLAP_PX=120
SCROLL_SHRINK_RETRIES=2
SCROLL_SETTLE_MS=350
MAX_VIEWPORT_SWEEPS=200
SCREENSHOT_MASK_SELECTORS=
SCREENSHOT_STYLE_HASH=dev-sweeps-v1
CAPTURE_VIEWPORT_WIDTH=1280
CAPTURE_VIEWPORT_HEIGHT=2000
CAPTURE_DEVICE_SCALE_FACTOR=2
CAPTURE_COLOR_SCHEME=light
CANVAS_WARNING_THRESHOLD=3
VIDEO_WARNING_THRESHOLD=2
SEAM_WARNING_RATIO=0.9
SEAM_WARNING_MIN_PAIRS=5
SCROLL_SHRINK_WARNING_THRESHOLD=1
OVERLAP_WARNING_RATIO=0.65
BLOCKLIST_PATH=config/blocklist.json
WARNING_LOG_PATH=ops/warnings.jsonl
PROMETHEUS_PORT=9000
HTMX_SSE_HEARTBEAT_MS=4000
OCR_MAX_CONCURRENCY=8
OCR_MIN_CONCURRENCY=2
WEBHOOK_SECRET=mdwb-dev-webhook
MDWB_SERVER_IMPL=uvicorn
# --- Optional semantic post-processing (endpoint/model/key are above) ---
SEMANTIC_POST_ENABLED=false
SEMANTIC_POST_TIMEOUT_MS=30000
SEMANTIC_POST_MAX_CHARS=
# Optional overrides for server launcher (scripts/run_server.py)
# MDWB_SERVER_WORKERS=4
# MDWB_GRANIAN_RUNTIME_THREADS=2
# MDWB_SERVER_LOG_LEVEL=info
# Optional override when smoke pointer files live outside benchmarks/production
MDWB_SMOKE_ROOT=benchmarks/production
# Opt-in fresh generated capture/OCR guardrail; enabled runs require hash-bound cases.
MDWB_RUN_E2E_GENERATED=false
MDWB_GENERATED_E2E_CASES=tests/fixtures/e2e_generated/cases.json
